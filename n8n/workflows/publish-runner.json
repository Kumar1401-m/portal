{
  "name": "Portal — publish what is due",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "d0a1b2c3-0001-4000-8000-000000000001",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-220, 0],
      "notes": "Vercel's Hobby plan allows one cron run a day, which cannot serve a 6-8 PM posting window. This is the whole reason n8n is here."
    },
    {
      "parameters": {
        "url": "https://nvkhub.vercel.app/api/automation/publish/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "d0a1b2c3-0002-4000-8000-000000000002",
      "name": "Run the publisher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0],
      "notes": "GET, no body. Safe to call as often as you like: each video is claimed before anything is sent to Instagram, so two overlapping runs cannot post the same reel. neverError is on so a bad response reaches the check below instead of failing the node silently.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "portal-cron-secret",
          "name": "Portal CRON_SECRET"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "status-not-ok",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d0a1b2c3-0003-4000-8000-000000000003",
      "name": "Did it fail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 0],
      "notes": "401 means the header credential does not match CRON_SECRET on Vercel. 404 means PORTAL_URL is wrong."
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "=Portal publisher returned {{ $json.statusCode }}: {{ JSON.stringify($json.body) }}"
      },
      "id": "d0a1b2c3-0004-4000-8000-000000000004",
      "name": "Stop and report",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [440, -100],
      "notes": "Fails the execution so it shows red in n8n's list. A publisher that quietly stopped working is the failure worth catching."
    },
    {
      "parameters": {},
      "id": "d0a1b2c3-0005-4000-8000-000000000005",
      "name": "Nothing to do",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [440, 100],
      "notes": "A normal run: the response says how many were posted, and zero is the usual answer outside the evening window."
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [[{ "node": "Run the publisher", "type": "main", "index": 0 }]]
    },
    "Run the publisher": {
      "main": [[{ "node": "Did it fail?", "type": "main", "index": 0 }]]
    },
    "Did it fail?": {
      "main": [
        [{ "node": "Stop and report", "type": "main", "index": 0 }],
        [{ "node": "Nothing to do", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveExecutionProgress": false
  },
  "pinData": {}
}
