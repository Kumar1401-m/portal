{
  "name": "Portal — publish what is due",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "d0a1b2c3-0001-4000-8000-000000000001",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-240, 0],
      "notes": "Vercel's Hobby plan allows one cron run a day, which cannot serve a 6-8 PM posting window. This is the whole reason n8n is here."
    },
    {
      "parameters": {
        "url": "https://nvkhub.vercel.app/api/automation/publish/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "PASTE_CRON_SECRET_HERE"
            }
          ]
        },
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "d0a1b2c3-0002-4000-8000-000000000002",
      "name": "Run the publisher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, 0],
      "notes": "The key goes straight in the header rather than through an n8n credential — one field to fill, and no credential to create or attach. Replace PASTE_CRON_SECRET_HERE with the CRON_SECRET from deploy/.env. GET, no body. Safe at any frequency: each video is claimed before anything is sent to Instagram, so overlapping runs cannot post the same reel twice."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "status-not-ok",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d0a1b2c3-0003-4000-8000-000000000003",
      "name": "Did it fail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [200, 0],
      "notes": "401 means the header value is not the CRON_SECRET. Point the URL at /api/automation/whoami to be told exactly which way it is wrong."
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "=Portal publisher returned {{ $json.statusCode }}: {{ JSON.stringify($json.body) }}"
      },
      "id": "d0a1b2c3-0004-4000-8000-000000000004",
      "name": "Stop and report",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [420, -100],
      "notes": "Fails the execution so it shows red in the Executions list. A publisher that quietly stopped working is the failure worth catching."
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [[{ "node": "Run the publisher", "type": "main", "index": 0 }]]
    },
    "Run the publisher": {
      "main": [[{ "node": "Did it fail?", "type": "main", "index": 0 }]]
    },
    "Did it fail?": {
      "main": [[{ "node": "Stop and report", "type": "main", "index": 0 }], []]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveExecutionProgress": false
  },
  "pinData": {}
}
