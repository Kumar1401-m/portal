{
  "name": "Portal — nightly caption analysis",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 2 * * *"
            }
          ]
        }
      },
      "id": "e0a1b2c3-0001-4000-8000-000000000001",
      "name": "02:30 every night",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-240, 0],
      "notes": "Overnight because analysing a video costs an AI call per video and nobody is waiting on it."
    },
    {
      "parameters": {
        "url": "https://nvkhub.vercel.app/api/automation/analyse",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "PASTE_CRON_SECRET_HERE"
            }
          ]
        },
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "e0a1b2c3-0002-4000-8000-000000000002",
      "name": "Analyse new videos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, 0],
      "notes": "Replace PASTE_CRON_SECRET_HERE with the CRON_SECRET from deploy/.env — the same value as the publish workflow."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "status-not-ok",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e0a1b2c3-0003-4000-8000-000000000003",
      "name": "Did it fail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "=Portal analyse returned {{ $json.statusCode }}: {{ JSON.stringify($json.body) }}"
      },
      "id": "e0a1b2c3-0004-4000-8000-000000000004",
      "name": "Stop and report",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [420, -100]
    }
  ],
  "connections": {
    "02:30 every night": {
      "main": [[{ "node": "Analyse new videos", "type": "main", "index": 0 }]]
    },
    "Analyse new videos": {
      "main": [[{ "node": "Did it fail?", "type": "main", "index": 0 }]]
    },
    "Did it fail?": {
      "main": [[{ "node": "Stop and report", "type": "main", "index": 0 }], []]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none"
  },
  "pinData": {}
}
