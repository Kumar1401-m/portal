{
  "name": "Portal — WhatsApp scheduled reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-240, 0],
      "notes": "This is what makes \"send it at 6pm\" mean 6pm. The portal offers half-hour slots, so a five-minute poll is comfortably inside the granularity anyone picks — a message goes out within five minutes of its slot, never before it. Cheap to run: a poll with nothing due is one indexed query and no message."
    },
    {
      "parameters": {
        "url": "https://nvkhub.vercel.app/api/automation/whatsapp/outbox",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "PASTE_CRON_SECRET_HERE"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Send anything due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, 0],
      "notes": "Replace PASTE_CRON_SECRET_HERE with the CRON_SECRET from deploy/.env — the same value the other workflows use. Safe to overlap: each message is claimed with a conditional UPDATE before it is sent, so two runs cannot both send the same one."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "status-not-ok",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Did it fail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "=WhatsApp outbox returned {{ $json.statusCode }}: {{ JSON.stringify($json.body) }}"
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Stop and report",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [420, -100],
      "notes": "Worth catching. A scheduled reminder that silently never goes is invisible from the portal — the row just sits there looking patient — so the failure has to be loud here instead."
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [[{ "node": "Send anything due", "type": "main", "index": 0 }]]
    },
    "Send anything due": {
      "main": [[{ "node": "Did it fail?", "type": "main", "index": 0 }]]
    },
    "Did it fail?": {
      "main": [[{ "node": "Stop and report", "type": "main", "index": 0 }], []]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none"
  },
  "pinData": {}
}
