# ---------------------------------------------------------------------------
# n8n environment — copy to your n8n instance's environment (Docker env file,
# systemd unit, or n8n Cloud → Settings → Variables).
#
# NOTHING in this directory contains a secret. The workflow JSON only ever
# references $env.NAME, so the exported files are safe to commit and to share.
# ---------------------------------------------------------------------------

# Required so `{{ $env.X }}` resolves inside nodes. n8n blocks it by default.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Your portal -----------------------------------------------------------
# No trailing slash.
PORTAL_URL=https://your-portal.vercel.app
# Must match N8N_API_KEY in the portal's own environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_API_KEY=

# --- Meta Graph API --------------------------------------------------------
# Long-lived Page access token for the agency's Business Manager. Clients whose
# Instagram account sits outside it carry their own token on the client record
# instead, and the workflow prefers that one.
#
# Required permissions:
#   instagram_basic, instagram_content_publish, instagram_manage_insights,
#   pages_show_list, pages_read_engagement, business_management
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# --- WhatsApp Cloud API ----------------------------------------------------
# From Meta Business → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Optional. Without an approved template, free-form messages only reach a user
# within 24 hours of their last message to the business — which for most
# clients means never. Register a template and set its name here for reliable
# delivery. See README.md § WhatsApp.
WHATSAPP_TEMPLATE_NAME=

# --- n8n behaviour ---------------------------------------------------------
# The publisher waits on Meta's encoder; without this, long executions are
# pruned before they finish.
EXECUTIONS_DATA_MAX_AGE=336
GENERIC_TIMEZONE=Asia/Kolkata
