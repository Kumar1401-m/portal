# ---------------------------------------------------------------------------
# WhatsApp approval service — copy to .env and fill in.
#
# Nothing here is committed. The service refuses to start when a required
# value is missing, rather than booting and failing silently on every send.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# --- Your portal -----------------------------------------------------------
# No trailing slash. Must be reachable FROM this container.
PORTAL_URL=https://agency-next-tau.vercel.app

# Lets this service call the portal. Must equal WHATSAPP_SERVICE_KEY in the
# portal's own environment.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_API_KEY=

PORTAL_TIMEOUT_MS=20000

# --- Who may call THIS service ---------------------------------------------
# A different secret, in the other direction. Must equal WHATSAPP_SERVICE_TOKEN
# in the portal. Two keys rather than one so either side can be rotated alone.
SERVICE_API_KEY=

# --- WhatsApp session ------------------------------------------------------
# MUST be a persistent volume in Docker. Losing it forces a QR re-scan, and
# that is downtime nobody notices until an approval goes unanswered.
WA_SESSION_PATH=/app/.wwebjs_auth
WA_CLIENT_ID=agency-approvals
WA_HEADLESS=true

# Set by the Dockerfile. Leave blank when running on your own machine and
# Puppeteer will use its bundled Chromium.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Optional allow-list of group ids (comma separated). Empty = listen to every
# group, which is normal — the portal decides which ones it recognises.
WA_ALLOWED_GROUPS=

# --- Sending ---------------------------------------------------------------
SEND_MAX_ATTEMPTS=3
SEND_RETRY_DELAY_MS=15000
# WhatsApp rejects large media; above this the send fails with an unhelpful
# error, so it is caught before Chromium is asked to hold the bytes.
SEND_MAX_MEDIA_BYTES=16777216
# Gap between consecutive sends. WhatsApp treats bursts as spam.
SEND_THROTTLE_MS=3000

# --- Realtime --------------------------------------------------------------
# Browser origins allowed to open a Socket.IO connection to this service.
# Include both your production portal and http://localhost:3000 for dev.
CORS_ORIGINS=https://agency-next-tau.vercel.app,http://localhost:3000
