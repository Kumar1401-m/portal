# Live database credentials — from Vercel → Project → Settings →
# Environment Variables → Production. Click the eye icon to reveal each one.
#
# Copy this file to tools/live.env, fill it in, and run:
#     node tools/pull-live-db.mjs
#
# tools/live.env is git-ignored. Nothing here is ever sent anywhere except
# your own database.
LIVE_DB_HOST=
LIVE_DB_PORT=3306
LIVE_DB_USER=
LIVE_DB_PASSWORD=
LIVE_DB_NAME=
