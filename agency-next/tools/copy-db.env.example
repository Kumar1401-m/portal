# Moving the database to a new MySQL host.
#
# Copy this to tools/copy-db.env and fill it in. That file is git-ignored and
# never leaves this machine.
#
#   node tools/copy-db.mjs --dry-run    reach both, count the source, stop
#   node tools/copy-db.mjs              copy, then verify row by row

# The database you have now — from Vercel → Settings → Environment Variables.
SOURCE_DB_HOST=
SOURCE_DB_PORT=3306
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=
SOURCE_DB_NAME=

# The new one.
TARGET_DB_HOST=
TARGET_DB_PORT=3306
TARGET_DB_USER=
TARGET_DB_PASSWORD=
TARGET_DB_NAME=

# Managed hosts want TLS and will close the connection without it. Only set
# this to "off" if both sides are on this machine.
SSL=on
