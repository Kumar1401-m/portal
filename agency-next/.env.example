# Agency ERP (Next.js) — copy to .env.local and fill in.
# Connects to the SAME MySQL database as the original portal (agency_erp),
# so there is no data migration.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agency_erp
DB_CONNECTION_LIMIT=10

# Session JWT — reuse the original portal's JWT_SECRET for consistency.
JWT_SECRET=change_me
JWT_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

APP_NAME=Agency ERP

# Absolute base URL. Needed for links in email, which have no origin to
# resolve a relative path against. Vercel's own domain is used when unset.
APP_URL=

# ---------------------------------------------------------------------------
# n8n automation  (src/app/api/automation/*)
# ---------------------------------------------------------------------------
# Shared secret for the automation API. Must match PORTAL_API_KEY in n8n.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Kept separate from ZAPIER_API_KEY on purpose: these endpoints can publish to
# a client's Instagram account, so the credential should be revocable on its
# own. Falls back to ZAPIER_API_KEY only so an existing install keeps working.
N8N_API_KEY=

# Legacy Zapier integration (src/app/api/zapier/*). Leave blank if unused.
ZAPIER_API_KEY=

# ---------------------------------------------------------------------------
# Meta Graph API
# ---------------------------------------------------------------------------
# Long-lived Page access token, used when a client has no token of its own.
# n8n normally holds this; the portal only needs it for Graph calls it makes
# directly.
#
# Permissions: instagram_basic, instagram_content_publish,
# instagram_manage_insights, pages_show_list, pages_read_engagement
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# WhatsApp Cloud API — "your post is live" notifications
# ---------------------------------------------------------------------------
# Optional: the shipped n8n workflow sends this itself. Fill these in only if
# the portal should also be able to send it (a manual button, or an install
# running without n8n).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Strongly recommended. Free-form WhatsApp text only reaches a user within 24
# hours of their last message to the business — which for most clients is
# never. An approved template works at any time.
WHATSAPP_TEMPLATE_NAME=

# ---------------------------------------------------------------------------
# Email (SMTP) — approval requests, receipts, post confirmations, reports
# ---------------------------------------------------------------------------
# Every send is a no-op when SMTP_HOST/SMTP_USER are blank, so the portal works
# fine without it — it just logs "[email skipped]" instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Agency ERP <no-reply@agency.com>

# ---------------------------------------------------------------------------
# AI — captions and analytics recommendations
# ---------------------------------------------------------------------------
# Both optional. Without either, captions fall back to a deterministic draft
# and analytics recommendations are written from the statistics alone.
# OpenAI is tried first when both are set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
