# ============================================================
#  Agency ERP + CRM + Client Portal - Environment Config
#  Copy this file to ".env" and fill in your values.
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
APP_NAME=Agency ERP

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agency_erp
DB_CONNECTION_LIMIT=10

# ---- Authentication (JWT) ----
# Use long random strings in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change_this_access_secret_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# ---- Default Super Admin (created on seed) ----
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@agency.com
SUPERADMIN_PASSWORD=Admin@12345

# ---- Integrations (all optional; features degrade gracefully) ----

# OpenAI (paid) — highest quality captions/analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (FREE tier) — get a key at https://aistudio.google.com/apikey
# Used for AI captions when OPENAI_API_KEY is not set. Handles Telugu/Tenglish well.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta Graph API (Instagram / Facebook)
META_GRAPH_TOKEN=
META_GRAPH_VERSION=v21.0

# YouTube Data API v3 (channel statistics)
YOUTUBE_API_KEY=

# Google Drive API
GOOGLE_DRIVE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Agency ERP <no-reply@agency.com>"

# ---- Security ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CORS_ORIGIN=http://localhost:4000
