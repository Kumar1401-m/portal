# Copy to .env in this folder and fill in. Nothing here has a safe default.
#
#   cp .env.example .env
#
# Generate every secret below with:
#   openssl rand -hex 32

# ---------------------------------------------------------------------------
# The portal
# ---------------------------------------------------------------------------
PORTAL_URL=https://nvkhub.vercel.app

# TWO different keys, both of which the portal checks — do not set them to the
# same value and do not swap them. Each container receives whichever one it
# needs as PORTAL_API_KEY; the compose file does that mapping.
#
#   n8n  ->  portal    must match N8N_API_KEY in Vercel
#                      (the portal accepts ZAPIER_API_KEY as a fallback, so
#                       check which is actually set there)
N8N_PORTAL_KEY=
#   service -> portal  must match WHATSAPP_SERVICE_KEY in Vercel
WA_PORTAL_KEY=

# ---------------------------------------------------------------------------
# Instagram publishing
# ---------------------------------------------------------------------------
# Long-lived Page access token with instagram_content_publish, instagram_basic,
# pages_show_list and pages_read_engagement. A token straight from Graph
# Explorer expires in about an hour — exchange it for a long-lived one first,
# or posting stops working the same afternoon.
#
# A client with its own token stored in the portal overrides this one.
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# WhatsApp service
# ---------------------------------------------------------------------------
# Inside the compose network the service answers to its own name, so this needs
# no TLS and no public port.
WHATSAPP_SERVICE_URL=http://whatsapp-service:4000

# One secret under two names, because each side reads its own:
#   SERVICE_API_KEY         the service checks incoming calls against this
#   WHATSAPP_SERVICE_TOKEN  n8n sends it (and so does the portal)
# These two MUST be identical. The portal's WHATSAPP_SERVICE_TOKEN must match
# them as well.
SERVICE_API_KEY=
WHATSAPP_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# n8n itself
# ---------------------------------------------------------------------------
# The hostname you point at this box, without https://
N8N_HOST=n8n.your-domain.com

N8N_USER=admin
N8N_PASSWORD=

# Encrypts saved credentials. Set once and leave it: changing it later makes
# every stored credential unreadable and they all have to be entered again.
N8N_ENCRYPTION_KEY=

TZ=Asia/Kolkata
