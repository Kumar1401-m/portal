# Copy to .env in this folder and fill in.
#
#   cp .env.example .env
#
# Generate the secrets with:
#   openssl rand -hex 32

# ---------------------------------------------------------------------------
# The portal
# ---------------------------------------------------------------------------
PORTAL_URL=https://nvkhub.vercel.app

# The key this service uses to report a client's APPROVE or CHANGE reply back
# to the portal. Must match WHATSAPP_SERVICE_KEY in Vercel.
WA_PORTAL_KEY=

# ---------------------------------------------------------------------------
# This service
# ---------------------------------------------------------------------------
# One secret under two names, because each side reads its own:
#   SERVICE_API_KEY         this service checks incoming calls against it
#   WHATSAPP_SERVICE_TOKEN  the portal sends it
# They must be identical, and must match WHATSAPP_SERVICE_TOKEN in Vercel.
SERVICE_API_KEY=
WHATSAPP_SERVICE_TOKEN=

# The hostname you point at this box, without https://
WA_HOST=wa.your-domain.com

TZ=Asia/Kolkata
